{
  "name": "js-example",
  "version": "1.0.0",
  "description": "This is the JS example of interacting with Portal's MPC Signer API",
  "main": "main.js",
  "scripts": {
    "start": "node main.js",
    "signup": "node -e 'require(\"./signup.js\")().catch(console.error)'",
    "generate": "node -e 'require(\"./generate.js\")().catch(console.error)'",
    "backup": "node -e 'require(\"./backup.js\")().catch(console.error)'",
    "recover": "node -e 'require(\"./recover.js\")().catch(console.error)'",
    "signeth": "node -e 'require(\"./eth-sign.js\")().catch(console.error)'",
    "signsol": "node -e 'require(\"./sol-sign.js\").SignSol(\"\").catch(console.error)'",
    "signsolMessage": "node -e 'require(\"./sol-sign.js\").SignSolMessage(\"sign this\").catch(console.error)'",
    "cosignsol": "node -e 'require(\"./sol-sign.js\").CoSignTransaction().catch(console.error)'",
    "stellarRaw": "node -e 'require(\"./stellar.js\").SignStellar().catch(console.error)'",
    "stellar": "node -e 'require(\"./stellar-sign.js\").SignStellar().catch(console.error)'",
    "tronRaw": "node -e 'require(\"./tron-raw.js\").SignTron().catch(console.error)'",
    "tron": "node -e 'require(\"./tron-sign.js\").SignTron().catch(console.error)'",
    "tron-send": "node -e 'require(\"./tron-send-assets.js\").SignTron().catch(console.error)'",
    "tron-monitor": "node -e 'require(\"./tron-transaction-monitoring.js\").TronPoll().catch(console.error)'",
    "btc": "node -e 'require(\"./btc.js\").PortalBitcoin().catch(console.error)'",
    "lint": "eslint . --fix",
    "format": "prettier --write ."
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@noble/secp256k1": "^1.7.1",
    "@solana/web3.js": "^1.93.2",
    "@stellar/stellar-sdk": "^12.2.0",
    "@zerodev/ecdsa-validator": "5.0.0",
    "@zerodev/sdk": "5.0.0",
    "axios": "^1.7.2",
    "bigi": "^1.4.2",
    "bip32": "^5.0.0-rc.0",
    "bitcoinjs-lib": "^6.1.7",
    "crc": "^4.3.2",
    "dotenv": "^16.4.5",
    "permissionless": "0.0.30",
    "protobufjs": "^7.4.0",
    "stellar-sdk": "^12.2.0",
    "tiny-secp256k1": "^2.2.3",
    "tronweb": "^6.0.0",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1",
    "uuid": "^10.0.0",
    "viem": "2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.5.0",
    "eslint": "9.x",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "globals": "^15.6.0",
    "prettier": "^3.3.2"
  }
}
