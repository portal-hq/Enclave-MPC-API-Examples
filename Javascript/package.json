{
  "name": "js-example",
  "version": "1.0.0",
  "description": "This is the JS example of interacting with Portal's MPC Signer API",
  "main": "main.js",
  "scripts": {
    "backup": "node -e 'require(\"./backup.js\")().catch(console.error)'",
    "btc": "node -e 'require(\"./btc.js\").createTransaction(\"tb1qmg6kwp2zxqx522jfhs0ustgl88efxg0mhg3mrw\").catch(console.error)'",
    "cosignSolWithCoSigner": "node -e 'require(\"./sol-sign-cosigner.js\").CoSignTransactionWithCoSigner().catch(console.error)'",
    "cosignsol": "node -e 'require(\"./sol-sign.js\").CoSignTransaction().catch(console.error)'",
    "createSolCoSigner": "node -e 'require(\"./sol-cosigner.js\")().catch(console.error)'",
    "format": "prettier --write .",
    "generate": "node -e 'require(\"./generate.js\")().catch(console.error)'",
    "lifi:get-quote": "node -e 'require(\"./lifi-get-quote.js\")().catch(console.error)'",
    "lint": "eslint . --fix",
    "recover": "node -e 'require(\"./recover.js\")().catch(console.error)'",
    "signeth": "node -e 'require(\"./eth-sign.js\")().catch(console.error)'",
    "signeth-multiple": "node -e 'require(\"./eth-sign-multiple.js\")().catch(console.error)'",
    "signethAssets": "node -e 'require(\"./eth-send-assets.js\")().catch(console.error)'",
    "signethTypedData": "node -e 'require(\"./eth-sign-typed-data.js\")().catch(console.error)'",
    "signsol": "node -e 'require(\"./sol-sign.js\").SignSol(\"\").catch(console.error)'",
    "signsolMessage": "node -e 'require(\"./sol-sign.js\").SignSolMessage(\"sign this\").catch(console.error)'",
    "signup": "node -e 'require(\"./signup.js\")(process.argv.slice(1)).catch(console.error)'",
    "start": "node main.js",
    "stellar": "node -e 'require(\"./stellar-sign.js\").SignStellar().catch(console.error)'",
    "stellarRaw": "node -e 'require(\"./stellar.js\").SignStellar().catch(console.error)'",
    "tron": "node -e 'require(\"./tron-sign.js\").SignTron().catch(console.error)'",
    "tron-monitor": "node -e 'require(\"./tron-transaction-monitoring.js\").TronPoll().catch(console.error)'",
    "tron-send": "node -e 'require(\"./tron-send-assets.js\").SignTron().catch(console.error)'",
    "tronRaw": "node -e 'require(\"./tron-raw.js\").SignTron().catch(console.error)'",
    "yieldxyz": "node -e 'require(\"./yieldxyz.js\")().catch(console.error)'"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@noble/secp256k1": "^1.7.1",
    "@portal-hq/eject-js": "^1.0.0",
    "@protocolink/api": "^1.4.8",
    "@solana/web3.js": "^1.98.2",
    "@stellar/stellar-sdk": "^12.2.0",
    "@tatumio/tatum": "^4.2.49",
    "@zerodev/ecdsa-validator": "5.0.0",
    "@zerodev/sdk": "5.0.0",
    "axios": "^1.12.0",
    "bigi": "^1.4.2",
    "bip32": "^5.0.0-rc.0",
    "bitcoin-sdk-js": "^1.0.1",
    "bitcoinjs-lib": "^6.1.0",
    "crc": "^4.3.2",
    "dotenv": "^16.4.5",
    "ecpair": "^3.0.0",
    "permissionless": "0.0.30",
    "protobufjs": "^7.4.0",
    "stellar-sdk": "^12.2.0",
    "tiny-secp256k1": "^2.2.3",
    "tronweb": "^6.0.2",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1",
    "uuid": "^10.0.0",
    "viem": "2.0.0",
    "web3": "^4.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.5.0",
    "eslint": "9.x",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "globals": "^15.6.0",
    "prettier": "^3.3.2"
  },
  "resolutions": {
    "@babel/runtime": "^7.26.10",
    "@openzeppelin/contracts": "^4.8.3",
    "axios": "^1.8.4",
    "ws": "^8.18.0"
  }
}
